&control
    calculation='nscf'
    prefix='gan'
    restart_mode='from_scratch'
    pseudo_dir='./pp/'
    outdir='./'
    tprnfor=.true.
    tstress=.true.
    wf_collect = .true.
    verbosity = 'high'
 /
 &system
    ibrav    = 4
    celldm(1)= 6.02
    celldm(3)= 1.625
    nat      = 4
    ntyp     = 2
    ecutwfc  = 200
    nbnd     = 30
 /
 &electrons
    diagonalization='david'
    mixing_beta=0.7
    conv_thr=1.0d-14
    diago_full_acc = .true.

&CONTROL
    calculation   = 'vc-relax',   
    restart_mode  = 'from_scratch',
    prefix        = 'gan',       
    outdir = './',
    pseudo_dir = './pp',
    etot_conv_thr = 1.0d-5,
    forc_conv_thr = 1.0d-4,
    tprnfor = .true.,
/
&SYSTEM
    ibrav       = 4,
    celldm(1)   = 6.02,
    celldm(3)   = 1.625,
    nat         = 4,
    ntyp        = 2,
    ecutwfc     = 100.0,
    ecutrho     = 800.0,
/
&ELECTRONS
    conv_thr    = 1.0d-8,
    mixing_beta = 0.7
/
&IONS
/
&CELL
    cell_dofree = 'all'
/
ATOMIC_SPECIES
    Ga   69.723   Ga_ONCV_LDA-1.0.UPF
    N    14.007   N_ONCV_LDA-1.0.UPF

ATOMIC_POSITIONS crystal
  Ga  0.666666666667 0.333333333333  0.0
  N   0.666666666667 0.333333333333  0.376429222
  Ga  0.333333333333 0.666666666667  0.5
  N   0.333333333333 0.666666666667  0.876429222 

K_POINTS (automatic)
    8 8 8 0 0 0
